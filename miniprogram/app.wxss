page{background:#F5F8F6;color:#202725;font-size:30rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{min-height:100vh;padding:40rpx 36rpx 72rpx;box-sizing:border-box;transition:background-color .25s,color .25s}.theme-danqing{--bg:#F5F8F6;--surface:#FCFDFC;--surface-2:#E8F0ED;--text:#20302D;--muted:#77827F;--primary:#2E675F;--accent:#C88465;--line:#DCE5E1;--soft:#DDEAE6;--danger:#A7463F}.theme-warm{--bg:#F8F3EB;--surface:#FFFDF9;--surface-2:#EEE3D3;--text:#352C25;--muted:#84786D;--primary:#72513A;--accent:#8A9273;--line:#E8DCCB;--soft:#E9DDCC;--danger:#A6473F}.theme-red{--bg:#FFF8F2;--surface:#FFFCF8;--surface-2:#F7E2DA;--text:#2B211F;--muted:#89746F;--primary:#B93632;--accent:#B89A65;--line:#F0D7CE;--soft:#F4DED7;--danger:#A52522}.theme-danqing,.theme-warm,.theme-red{background:var(--bg);color:var(--text)}.title{font-size:56rpx;line-height:1.15;font-weight:760;letter-spacing:1rpx}.muted{color:var(--muted)}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:var(--primary);font-weight:700;margin-bottom:14rpx}.row{display:flex;align-items:center;justify-content:space-between}.amount{font-size:38rpx;font-weight:680}.receive{color:var(--primary)}.give{color:var(--accent)}.empty{text-align:center;padding:140rpx 30rpx;color:var(--muted);white-space:pre-line}.btn{background:var(--primary)!important;color:#fff!important;border-radius:22rpx}.ghost{background:var(--soft)!important;color:var(--primary)!important}.danger{background:#FFF1EF!important;color:var(--danger)!important}.field{background:var(--surface);border-radius:22rpx;padding:26rpx;margin:18rpx 0}.label{font-size:25rpx;color:var(--muted);margin-bottom:12rpx}.section{font-weight:650;margin:32rpx 0 16rpx}.pill{font-size:24rpx;background:var(--soft);color:var(--primary);padding:8rpx 16rpx;border-radius:999rpx}.chevron{color:var(--muted);font-size:40rpx;font-weight:300}
