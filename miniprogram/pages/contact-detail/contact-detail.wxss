.contact-detail-page{padding:48rpx 34rpx 190rpx}.person-head{display:flex;align-items:center}.person-avatar{width:108rpx;height:108rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--primary);color:#fff;font-size:42rpx;font-weight:700}.person-copy{flex:1;margin-left:24rpx}.person-head .title{font-size:48rpx}.edit-person{background:var(--soft)!important;color:var(--primary)!important;font-size:23rpx;border-radius:999rpx;padding:0 23rpx}.edit-person::after{border:0}.notes-card{background:var(--surface);border-radius:22rpx;padding:24rpx 26rpx;margin-top:26rpx;line-height:1.6}.notes-label{font-size:22rpx;margin-bottom:7rpx}.summary-card{background:var(--surface-2);border-radius:30rpx;padding:30rpx;margin-top:28rpx}.summary-title{font-size:27rpx;font-weight:680}.amount-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:28rpx 0}.amount-block{background:var(--surface);border-radius:20rpx;padding:22rpx}.amount-block .muted{font-size:22rpx}.amount-block .amount{margin-top:8rpx}.balance-row{display:flex;align-items:flex-end;justify-content:space-between;border-top:1rpx solid var(--line);padding-top:24rpx}.balance-message{font-size:22rpx;color:var(--muted);margin-top:7rpx}.balance-amount{font-size:42rpx;font-weight:730;color:var(--primary)}.history-head{display:flex;align-items:center;justify-content:space-between}.view-all{font-size:24rpx;color:var(--primary)}.history-list{background:var(--surface);border-radius:26rpx;padding:0 24rpx}.history-row{display:flex;align-items:center;min-height:124rpx;border-bottom:1rpx solid var(--line)}.history-row:last-child{border:0}.date-block{width:70rpx;text-align:center}.date-day{font-size:34rpx;font-weight:700}.date-block .muted{font-size:20rpx}.history-copy{flex:1;margin-left:20rpx}.history-event{font-weight:650;margin-bottom:6rpx}.history-copy .muted{font-size:22rpx}.history-row .amount{font-size:31rpx}.history-empty{padding:56rpx 20rpx}.delete-contact{margin-top:30rpx;background:transparent!important;color:var(--danger)!important;font-size:25rpx}.delete-contact::after{border:0}.record-bar{position:fixed;left:0;right:0;bottom:0;padding:20rpx 34rpx calc(env(safe-area-inset-bottom) + 22rpx);background:rgba(245,248,246,.96);z-index:10}.theme-warm .record-bar{background:rgba(248,243,235,.96)}.theme-red .record-bar{background:rgba(255,248,242,.96)}.record-button{height:98rpx;background:var(--primary)!important;color:#fff!important;border-radius:24rpx;font-size:33rpx;font-weight:700}.record-button::after{border:0}
