.edit-profile-page{padding-top:60rpx}.avatar-section{text-align:center}.avatar-picker{position:relative;width:176rpx;height:176rpx;padding:0;border-radius:50%;overflow:visible;background:transparent!important}.avatar-picker::after{border:0}.avatar-preview{width:176rpx;height:176rpx;border-radius:50%}.avatar-fallback{display:flex;align-items:center;justify-content:center;background:var(--primary);color:#fff;font-size:56rpx}.avatar-badge{position:absolute;right:-8rpx;bottom:4rpx;background:var(--primary);color:#fff;font-size:21rpx;padding:9rpx 15rpx;border-radius:999rpx}.album-button{margin-top:22rpx;background:transparent!important;color:var(--primary)!important;font-size:25rpx}.album-button::after{border:0}.profile-form{background:var(--surface);border-radius:28rpx;padding:30rpx;margin-top:48rpx}.form-label{font-size:26rpx;color:var(--muted);margin-bottom:16rpx}.nickname-input{font-size:36rpx;font-weight:650;height:72rpx;border-bottom:1rpx solid var(--line)}.hint{font-size:22rpx;margin-top:16rpx}.save-profile{margin-top:42rpx;height:100rpx;border-radius:24rpx;background:var(--soft)!important;color:var(--primary)!important;font-weight:680}.save-profile.active{background:var(--primary)!important;color:#fff!important}
