<view class="page theme-{{theme}} edit-profile-page"><view class="avatar-section"><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar"><image wx:if="{{avatarUrl}}" class="avatar-preview" src="{{avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar-preview avatar-fallback">{{nicknameChar||'微'}}</view><view class="avatar-badge">更换</view></button><button class="album-button" bindtap="chooseFromAlbum">从相册选择图片</button></view><view class="profile-form"><view class="form-label">昵称</view><input class="nickname-input" type="nickname" value="{{nickname}}" bindinput="nicknameInput" maxlength="24" placeholder="请输入昵称"/><view class="muted hint">点击输入框可使用微信昵称，也可以自己修改</view></view><button class="save-profile {{canSave?'active':''}}" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存资料</button></view>
