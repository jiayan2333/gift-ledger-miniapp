<view class="page theme-{{theme}} home-page">
  <view class="hero"><view class="eyebrow">LIFELONG LEDGER</view><view class="title">人情往来</view><view class="muted subtitle">每一份往来，都有迹可循。</view><view class="hero-rule"></view></view>
  <view wx:if="{{records.length}}" class="summary-card"><view class="summary-item"><view class="muted">收到</view><view class="summary-money receive">{{summary.receivedText}}</view></view><view class="summary-divider"></view><view class="summary-item"><view class="muted">给出</view><view class="summary-money give">{{summary.givenText}}</view></view><view class="summary-divider"></view><view class="summary-item"><view class="muted">结余</view><view class="summary-money {{summary.net>=0?'receive':'give'}}">{{summary.netText}}</view></view></view>
  <view wx:if="{{!records.length}}" class="empty">还没有人情往来记录\n从「记一笔」开始记录吧。</view>
  <view wx:else><view class="timeline-heading"><view class="section">往来时间线</view><view class="muted">新 → 旧</view></view><view class="timeline-flow"><view wx:for="{{records}}" wx:key="_id" class="timeline-row" data-id="{{item.contactId}}" bindtap="detail"><view class="timeline-rail"><view class="timeline-dot {{item.direction==='RECEIVE'?'receive-dot':'give-dot'}}"></view></view><view class="timeline-date"><view class="date-day">{{item.day}}</view><view class="muted">{{item.yearMonth}}</view></view><view class="timeline-main"><view class="name">{{item.contactName}}</view><view class="muted event">{{item.eventName}} · {{item.direction==='RECEIVE'?'对方给我':'我给对方'}}</view></view><view class="timeline-money {{item.direction==='RECEIVE'?'receive':'give'}}"><view class="amount">{{item.amountText}}</view><view class="open-detail">查看详情 ›</view></view></view></view></view>
</view>
