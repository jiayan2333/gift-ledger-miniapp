.home-page{padding-top:58rpx}.subtitle{font-size:29rpx;margin-top:14rpx}.hero-rule{width:56rpx;height:5rpx;border-radius:9rpx;background:var(--accent);margin-top:28rpx}.summary-card{display:flex;align-items:center;background:var(--surface);border-radius:30rpx;padding:30rpx 12rpx;margin-top:38rpx}.summary-item{flex:1;text-align:center;min-width:0}.summary-item .muted{font-size:21rpx}.summary-money{font-size:27rpx;font-weight:720;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.summary-divider{width:1rpx;height:58rpx;background:var(--line)}.timeline-heading{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx}.timeline-heading .muted{font-size:21rpx}.timeline-flow{background:var(--surface);border-radius:30rpx;padding:0 22rpx;overflow:hidden}.timeline-row{position:relative;display:flex;align-items:center;min-height:178rpx;padding-left:58rpx;border-bottom:1rpx solid var(--line);box-sizing:border-box}.timeline-row:last-child{border:0}.timeline-rail{position:absolute;left:24rpx;top:0;bottom:0;width:2rpx;background:var(--line)}.timeline-row:first-child .timeline-rail{top:50%}.timeline-row:last-child .timeline-rail{bottom:50%}.timeline-dot{position:absolute;left:50%;top:50%;width:17rpx;height:17rpx;border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 8rpx var(--surface)}.receive-dot{background:var(--primary)}.give-dot{background:var(--accent)}.timeline-date{width:92rpx;text-align:center}.date-day{font-size:36rpx;font-weight:720}.timeline-date .muted{font-size:18rpx}.timeline-main{flex:1;margin-left:18rpx}.name{font-size:33rpx;font-weight:680}.event{font-size:21rpx;margin-top:8rpx}.timeline-money{text-align:right}.timeline-money .amount{font-size:30rpx}.open-detail{font-size:19rpx;color:var(--muted);margin-top:9rpx}.theme-red .hero-rule{background:var(--primary)}
