<view class="page theme-{{theme}} profile-page">
  <view class="profile-head"><view bindtap="editProfile"><image wx:if="{{user.avatarUrl}}" class="profile-avatar image-avatar" src="{{user.avatarUrl}}" mode="aspectFill"/><view wx:else class="profile-avatar">{{avatarChar||'微'}}</view></view><view class="profile-copy"><view class="title">{{user.nickname||'微信用户'}}</view><view class="muted">长期人情往来账本</view></view></view>
  <view class="ledger-band" bindtap="openLedgers"><view><view class="ledger-title">高级账本</view><view class="muted">礼簿拍一拍，批量整理人情往来</view></view><view class="quota"><text class="muted">剩余</text> {{user.ledgerQuota||0}} <text class="chevron">›</text></view></view>
  <view class="settings-list"><view class="settings-row" bindtap="exportExcel"><text>{{exporting?'正在生成 Excel…':'导出 Excel'}}</text><text class="chevron">›</text></view><view class="settings-row" bindtap="openThemes"><text>界面皮肤</text><view><text class="theme-value">{{themeName}}</text><text class="chevron">›</text></view></view><view class="settings-row" bindtap="feedback"><text>意见反馈</text><text class="chevron">›</text></view></view>
  <button class="cancel-account" bindtap="cancel">注销账号</button>
  <view wx:if="{{showThemes}}" class="sheet-mask" bindtap="closeThemes"><view class="theme-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title">选择界面皮肤</view><view class="muted sheet-subtitle">随时切换，不影响账本数据</view><view class="theme-grid"><view wx:for="{{themes}}" wx:key="id" class="theme-choice {{theme===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="chooseTheme"><view class="theme-preview preview-{{item.id}}"><view class="preview-circle"></view><view class="preview-line"></view></view><view class="choice-name">{{item.name}}</view><view class="choice-desc">{{item.desc}}</view><view wx:if="{{theme===item.id}}" class="check">✓</view></view></view></view></view>
</view>
