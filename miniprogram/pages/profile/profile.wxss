.profile-page{padding-top:58rpx}.profile-head{display:flex;align-items:center;padding:18rpx 8rpx 38rpx}.profile-avatar{width:120rpx;height:120rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--primary);color:#fff;font-size:44rpx;margin-right:28rpx}.profile-head .title{font-size:45rpx}.ledger-band{display:flex;align-items:center;justify-content:space-between;background:var(--surface-2);border-radius:30rpx;padding:34rpx 30rpx;margin:12rpx 0 30rpx}.ledger-title{font-size:34rpx;font-weight:680;margin-bottom:10rpx}.ledger-band .muted{font-size:23rpx}.quota{font-size:39rpx;color:var(--primary);font-weight:700}.settings-list{background:var(--surface);border-radius:28rpx;padding:0 26rpx}.settings-row{min-height:104rpx;border-bottom:1rpx solid var(--line);display:flex;align-items:center;justify-content:space-between}.settings-row:last-child{border-bottom:0}.theme-value{color:var(--primary);margin-right:12rpx}.cancel-account{margin-top:28rpx;background:transparent!important;color:var(--danger)!important;font-size:27rpx}.sheet-mask{position:fixed;inset:0;background:rgba(24,27,26,.32);display:flex;align-items:flex-end;z-index:20}.theme-sheet{width:100%;background:var(--surface);border-radius:38rpx 38rpx 0 0;padding:18rpx 30rpx 54rpx;box-sizing:border-box}.sheet-handle{width:72rpx;height:7rpx;border-radius:9rpx;background:var(--line);margin:0 auto 28rpx}.sheet-title{text-align:center;font-size:38rpx;font-weight:720}.sheet-subtitle{text-align:center;font-size:24rpx;margin:10rpx 0 30rpx}.theme-grid{display:flex;gap:18rpx}.theme-choice{position:relative;flex:1;border:2rpx solid var(--line);border-radius:24rpx;overflow:hidden;background:var(--surface)}.theme-choice.selected{border-color:var(--primary);box-shadow:0 0 0 2rpx var(--primary)}.theme-preview{height:112rpx;padding:20rpx;box-sizing:border-box}.preview-danqing{background:#E6EFEC}.preview-warm{background:#EEE3D3}.preview-red{background:#F7E2DA}.preview-circle{width:34rpx;height:34rpx;border-radius:50%;background:var(--primary)}.preview-warm .preview-circle{background:#72513A}.preview-red .preview-circle{background:#B93632}.preview-line{height:5rpx;width:62%;border-radius:6rpx;background:rgba(43,33,31,.3);margin-top:18rpx}.choice-name{text-align:center;font-weight:680;margin-top:14rpx}.choice-desc{text-align:center;color:var(--muted);font-size:21rpx;margin:6rpx 0 16rpx}.check{position:absolute;right:8rpx;top:8rpx;width:34rpx;height:34rpx;border-radius:50%;background:var(--primary);color:#fff;text-align:center;line-height:34rpx;font-size:22rpx}
