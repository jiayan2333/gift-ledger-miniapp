<view class="page theme-{{theme}} create-ledger-page">
  <view class="title">创建高级账本</view>
  <view class="muted subtitle">创建后占用 1 个账本额度，账本永久保留。</view>

  <view wx:if="{{freeQuota>0}}" style="background:var(--soft);color:var(--primary);border-radius:24rpx;padding:24rpx 26rpx;margin-bottom:24rpx;font-size:23rpx;line-height:1.6">
    <view style="font-size:29rpx;font-weight:700;margin-bottom:5rpx">免费试用</view>
    <view>每位用户可免费创建 1 本高级账本，最多处理 20 张礼簿照片。</view>
  </view>

  <view class="create-form">
    <view class="field"><view class="label">账本名称</view><input value="{{name}}" bindinput="nameInput" placeholder="如：我的婚礼"/></view>
    <view class="field"><view class="label">事件</view><picker range="{{events}}" range-key="name" bindchange="eventChange"><view>{{eventName}}</view></picker></view>
    <view class="field"><view class="label">日期</view><picker mode="date" value="{{eventDate}}" bindchange="dateChange"><view>{{eventDate}}</view></picker></view>
  </view>

  <view class="quota-card"><view><view>剩余账本额度</view><view wx:if="{{freeQuota>0}}" class="muted">含 1 本免费试用额度</view></view><text class="quota-number">{{quota}}</text></view>
  <button wx:if="{{quota>0}}" class="btn create-button" bindtap="create" loading="{{saving}}">{{freeQuota>0?'免费创建试用账本':'创建高级账本'}}</button>

  <view wx:else class="ad-unlock">
    <view style="font-size:30rpx;font-weight:700;margin-bottom:8rpx">开通会员，获得账本额度</view>
    <view class="muted" style="font-size:23rpx;margin-bottom:20rpx">额度用于创建高级账本，已创建的账本永久保留。</view>
    <view wx:for="{{membershipPlans}}" wx:key="id" class="product">
      <view><view class="product-name">{{item.name}} · ¥{{item.price}}</view><view class="muted">{{item.description}}</view></view>
      <button size="mini" data-id="{{item.id}}" bindtap="buyMembership" loading="{{purchasingPlan===item.id}}" disabled="{{!!purchasingPlan}}">开通</button>
    </view>
    <view class="muted" style="font-size:21rpx;margin-top:18rpx;line-height:1.6">白银会员 9.9 元开通 1 本；黄金会员 19.9 元开通 5 本。支付成功后额度自动到账。</view>
  </view>
</view>
