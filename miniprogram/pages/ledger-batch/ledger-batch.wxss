.batch-page{padding-top:48rpx}.subtitle{margin:16rpx 0 30rpx}.mode-tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--surface);border-radius:20rpx;padding:7rpx;margin-bottom:22rpx}.mode{text-align:center;padding:17rpx;color:var(--muted);border-radius:15rpx}.mode.active{background:var(--primary);color:#fff}.contact-search{height:86rpx;background:var(--surface);border-radius:20rpx;padding:0 24rpx;margin-bottom:18rpx}.contact-amount-list{background:var(--surface);border-radius:24rpx;padding:0 22rpx}.contact-amount-row{display:flex;align-items:center;min-height:112rpx;border-bottom:1rpx solid var(--line)}.contact-amount-row:last-child{border:0}.contact-avatar{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--soft);color:var(--primary)}.contact-name{flex:1;margin-left:18rpx;font-weight:650}.contact-name .muted{font-size:20rpx;margin-top:4rpx}.money-box{display:flex;align-items:center;background:var(--bg);border-radius:14rpx;padding:0 14rpx}.money-box input{width:120rpx;height:64rpx;text-align:right}.batch-row{display:grid;grid-template-columns:48rpx 1fr 150rpx 40rpx;align-items:center;gap:12rpx;background:var(--surface);padding:18rpx;border-bottom:1rpx solid var(--line)}.batch-row:first-of-type{border-radius:22rpx 22rpx 0 0}.row-number{color:var(--muted);text-align:center}.batch-row input{background:var(--bg);height:70rpx;border-radius:14rpx;padding:0 16rpx}.money{text-align:right}.remove{font-size:36rpx;color:var(--muted);text-align:center}.add-row{margin-top:20rpx;background:var(--soft)!important;color:var(--primary)!important}.import-button{margin-top:34rpx;height:100rpx}
