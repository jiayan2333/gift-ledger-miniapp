<view class="page theme-{{theme}} batch-page"><view class="title">批量记录</view><view class="muted subtitle">事件、日期和收支方向统一使用账本设置。可分多次处理，不限制累计人数。</view><view class="mode-tabs"><view class="mode {{mode==='CONTACTS'?'active':''}}" data-mode="CONTACTS" bindtap="switchMode">选择联系人</view><view class="mode {{mode==='NEW'?'active':''}}" data-mode="NEW" bindtap="switchMode">录入新姓名</view></view><view wx:if="{{mode==='CONTACTS'}}"><input class="contact-search" value="{{keyword}}" bindinput="search" placeholder="搜索已有联系人"/><view class="contact-amount-list"><view wx:for="{{filteredContacts}}" wx:key="_id" class="contact-amount-row"><view class="contact-avatar">{{item.initialChar}}</view><view class="contact-name">{{item.name}}<view class="muted">{{item.relationship||'未填写关系'}}</view></view><view class="money-box"><text>¥</text><input type="digit" value="{{item.amount}}" data-id="{{item._id}}" bindinput="contactAmount" placeholder="金额"/></view></view></view></view><view wx:else><view wx:for="{{rows}}" wx:key="index" class="batch-row"><view class="row-number">{{index+1}}</view><input class="name" data-i="{{index}}" data-k="name" value="{{item.name}}" bindinput="rowInput" placeholder="姓名"/><input class="money" type="digit" data-i="{{index}}" data-k="amount" value="{{item.amount}}" bindinput="rowInput" placeholder="金额"/><text class="remove" data-i="{{index}}" bindtap="removeRow">×</text></view><button class="add-row" bindtap="addRow">＋ 添加一行</button></view><button class="btn import-button" bindtap="importRows" loading="{{saving}}">确认批量入账</button></view>
