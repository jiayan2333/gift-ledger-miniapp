<view class="page theme-{{theme}} ledger-page"><view class="ledger-hero"><view class="muted">{{ledger.eventName}} · {{ledger.eventDate}}</view><view class="title">{{ledger.name}}</view><view wx:if="{{ledger.accessType==='FREE_TRIAL'}}" class="trial-label">免费体验账本 · 最多 20 张照片</view><view class="summary"><view><text class="muted">共收到</text><view class="amount receive">{{summary.receivedText}}</view></view><view><text class="muted">共给出</text><view class="amount give">{{summary.givenText}}</view></view><view><text class="muted">记录</text><view class="amount">{{summary.count||0}}</view></view></view></view><view class="action-grid"><view class="action" bindtap="batch"><view class="action-title">批量记录</view><view class="muted">搜索联系人，只填金额</view></view><view class="action" bindtap="choosePhotos"><view class="action-title">读取礼簿照片</view><view class="muted">已上传 {{images.length}} / {{ledger.imageLimit||30}} 张</view></view></view><view wx:if="{{images.length}}" class="section">已上传照片</view><scroll-view wx:if="{{images.length}}" scroll-x class="image-scroll"><image wx:for="{{images}}" wx:key="_id" class="ledger-image" src="{{item.tempUrl}}" mode="aspectFill"/></scroll-view><button wx:if="{{images.length}}" class="btn ocr-button" bindtap="startOcr">开始识别照片</button><view class="section">账本记录</view><view wx:if="{{!records.length}}" class="empty small-empty">还没有正式入账记录</view><view wx:for="{{records}}" wx:key="_id" class="record-row"><view><view>{{item.contactName}}</view><view class="muted">{{item.eventDate}} · {{item.eventName}}</view></view><view class="amount {{item.direction==='RECEIVE'?'receive':'give'}}">{{item.amountText}}</view></view></view>
