.ledger-page{padding-top:46rpx}.ledger-hero{background:var(--surface-2);border-radius:30rpx;padding:32rpx}.ledger-hero .title{margin-top:12rpx}.summary{display:flex;justify-content:space-between;margin-top:34rpx}.summary .muted{font-size:21rpx}.summary .amount{font-size:30rpx;margin-top:7rpx}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin:26rpx 0}.action{background:var(--surface);border-radius:24rpx;padding:28rpx}.action-title{font-size:30rpx;font-weight:680;margin-bottom:8rpx}.action .muted{font-size:22rpx}.image-scroll{white-space:nowrap;margin-bottom:22rpx}.ledger-image{display:inline-block;width:190rpx;height:230rpx;border-radius:18rpx;margin-right:16rpx}.ocr-button{margin-bottom:30rpx}.record-row{display:flex;justify-content:space-between;align-items:center;background:var(--surface);padding:24rpx 26rpx;border-bottom:1rpx solid var(--line)}.record-row:first-of-type{border-radius:24rpx 24rpx 0 0}.record-row:last-child{border-radius:0 0 24rpx 24rpx;border:0}.record-row .muted{font-size:22rpx;margin-top:6rpx}.small-empty{padding:60rpx 20rpx}
