.create-ledger-page{padding-top:52rpx}.subtitle{margin:16rpx 0 34rpx}.create-form{background:var(--surface);border-radius:28rpx;padding:8rpx 26rpx}.create-form .field{padding:24rpx 0;border-bottom:1rpx solid var(--line);border-radius:0;margin:0}.create-form .field:last-child{border:0}.quota-card{display:flex;justify-content:space-between;background:var(--surface-2);padding:28rpx;border-radius:24rpx;margin:28rpx 0}.quota-number{font-size:40rpx;color:var(--primary);font-weight:700}.create-button{height:100rpx}.products{display:flex;flex-direction:column;gap:18rpx}.product{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:20rpx;background:var(--surface);border-radius:24rpx;padding:26rpx}.product.member{border:2rpx solid var(--accent)}.product-name{font-weight:680}.product .muted{font-size:22rpx;margin-top:6rpx}.price{font-size:34rpx;color:var(--primary);font-weight:700}.product button{background:var(--primary);color:#fff}
