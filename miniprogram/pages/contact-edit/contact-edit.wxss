.contact-edit-page{padding:52rpx 34rpx 210rpx}
.edit-hero{padding:4rpx 8rpx 38rpx}
.edit-subtitle{font-size:26rpx;line-height:1.6;margin-top:18rpx}
.form-card{background:var(--surface);border-radius:30rpx;padding:0 28rpx}
.form-item{padding:30rpx 0;border-bottom:1rpx solid var(--line)}
.form-item:last-child{border-bottom:0}
.form-label{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:650;color:var(--text);margin-bottom:18rpx}
.required,.optional{font-size:21rpx;font-weight:500;padding:5rpx 13rpx;border-radius:999rpx}
.required{background:var(--soft);color:var(--primary)}
.optional{color:var(--muted);background:var(--bg)}
.form-input{height:70rpx;font-size:31rpx;color:var(--text)}
.name-input{font-size:36rpx;font-weight:650}
.placeholder{color:#A8AEAB;font-weight:400}
.form-hint{font-size:22rpx;color:var(--muted);margin-top:8rpx}
.notes-item{position:relative}
.notes-input{width:100%;height:176rpx;box-sizing:border-box;font-size:29rpx;line-height:1.6;color:var(--text);padding-bottom:34rpx}
.notes-count{text-align:right;color:var(--muted);font-size:21rpx}
.privacy-note{text-align:center;color:var(--muted);font-size:22rpx;margin-top:28rpx}
.save-bar{position:fixed;left:0;right:0;bottom:0;padding:22rpx 34rpx calc(env(safe-area-inset-bottom) + 24rpx);background:rgba(245,248,246,.96);z-index:9}
.theme-warm .save-bar{background:rgba(248,243,235,.96)}
.theme-red .save-bar{background:rgba(255,248,242,.96)}
.save-button{height:100rpx;border-radius:24rpx;background:var(--soft)!important;color:var(--primary)!important;font-size:32rpx;font-weight:680;letter-spacing:1rpx}
.save-button.active{background:var(--primary)!important;color:#fff!important;box-shadow:0 12rpx 28rpx rgba(35,55,51,.12)}
.save-button::after{border:0}
