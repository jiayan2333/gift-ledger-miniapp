<view class="page theme-{{theme}} record-edit-page">
  <view class="record-head"><view class="eyebrow">GIFT RECORD</view><view class="title">{{id?'修改记录':'记一笔'}}</view><view class="contact-pill">与 {{contact.name||'联系人'}} 的往来</view></view>
  <view class="form-section"><view class="section-label">收支方向</view><view class="direction-grid"><view class="direction-choice give-choice {{form.direction==='GIVE'?'selected':''}}" data-value="GIVE" bindtap="chooseDirection"><view class="choice-title">我给对方</view><view class="choice-note">记录我的支出</view></view><view class="direction-choice receive-choice {{form.direction==='RECEIVE'?'selected':''}}" data-value="RECEIVE" bindtap="chooseDirection"><view class="choice-title">对方给我</view><view class="choice-note">记录我的收入</view></view></view></view>
  <view class="amount-section"><view class="section-label">金额</view><view class="amount-input-row"><text>¥</text><input type="digit" value="{{amountYuan}}" bindinput="amount" placeholder="0.00" focus="{{!id}}"/></view><view class="muted amount-hint">人民币金额，必须大于 0</view></view>
  <view class="form-section"><view class="section-label">事件</view><view class="event-grid"><view wx:for="{{events}}" wx:key="value" class="event-chip {{form.eventType===item.value?'active':''}}" data-value="{{item.value}}" bindtap="chooseEvent">{{item.name}}</view></view><view wx:if="{{form.eventType==='OTHER'}}" class="custom-event"><input value="{{form.customEventName}}" data-k="customEventName" bindinput="input" placeholder="请输入自定义事件名称" maxlength="20"/></view></view>
  <view class="date-section"><view><view class="section-label">发生日期</view><view class="muted">可以补录过去的人情往来</view></view><picker mode="date" value="{{form.eventDate}}" bindchange="date"><view class="date-picker">{{form.eventDate}} ›</view></picker></view>
  <button wx:if="{{id}}" class="delete-record" bindtap="remove">删除这笔记录</button>
  <view class="save-record-bar"><button class="save-record" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存记录</button></view>
</view>
