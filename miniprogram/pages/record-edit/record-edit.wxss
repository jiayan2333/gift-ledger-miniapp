.record-edit-page{padding:46rpx 34rpx 190rpx}.record-head{margin-bottom:30rpx}.contact-pill{display:inline-flex;margin-top:18rpx;background:var(--soft);color:var(--primary);padding:11rpx 18rpx;border-radius:999rpx;font-size:24rpx}.form-section,.amount-section,.date-section{background:var(--surface);border-radius:28rpx;padding:28rpx;margin-bottom:22rpx}.section-label{font-size:25rpx;font-weight:680;color:var(--muted);margin-bottom:18rpx}.direction-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.direction-choice{border:2rpx solid var(--line);border-radius:22rpx;padding:24rpx 20rpx}.direction-choice.selected{border-color:var(--primary);background:var(--soft)}.give-choice.selected{border-color:var(--accent)}.choice-title{font-size:30rpx;font-weight:680}.choice-note{font-size:21rpx;color:var(--muted);margin-top:8rpx}.amount-input-row{display:flex;align-items:center;border-bottom:1rpx solid var(--line);padding-bottom:10rpx}.amount-input-row text{font-size:48rpx;font-weight:700;color:var(--primary)}.amount-input-row input{height:90rpx;flex:1;font-size:64rpx;font-weight:730;margin-left:16rpx}.amount-hint{font-size:21rpx;margin-top:12rpx}.event-grid{display:flex;flex-wrap:wrap;gap:14rpx}.event-chip{padding:14rpx 21rpx;background:var(--bg);color:var(--muted);border-radius:999rpx;font-size:24rpx}.event-chip.active{background:var(--primary);color:#fff}.custom-event{margin-top:20rpx;background:var(--bg);border-radius:16rpx;padding:20rpx}.date-section{display:flex;align-items:center;justify-content:space-between}.date-section .section-label{margin-bottom:7rpx}.date-section .muted{font-size:21rpx}.date-picker{color:var(--primary);font-weight:680}.delete-record{background:transparent!important;color:var(--danger)!important;font-size:25rpx;margin-top:20rpx}.delete-record::after{border:0}.save-record-bar{position:fixed;left:0;right:0;bottom:0;padding:20rpx 34rpx calc(env(safe-area-inset-bottom) + 22rpx);background:rgba(245,248,246,.96);z-index:10}.theme-warm .save-record-bar{background:rgba(248,243,235,.96)}.theme-red .save-record-bar{background:rgba(255,248,242,.96)}.save-record{height:98rpx;background:var(--primary)!important;color:#fff!important;border-radius:24rpx;font-size:33rpx;font-weight:700}.save-record::after{border:0}
