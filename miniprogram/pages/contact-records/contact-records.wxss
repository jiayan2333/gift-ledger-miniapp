.records-page{padding-top:48rpx;padding-bottom:180rpx}.records-head .title{font-size:46rpx;margin-bottom:12rpx}.records-list{margin-top:34rpx;background:var(--surface);border-radius:28rpx;padding:10rpx 24rpx}.record-item{display:grid;grid-template-columns:92rpx 30rpx 1fr auto;align-items:center;min-height:142rpx}.record-date{text-align:center;font-size:25rpx}.record-date .year{font-size:20rpx;color:var(--muted);margin-bottom:4rpx}.record-line{height:100%;position:relative;display:flex;justify-content:center}.record-line::before{content:"";width:2rpx;height:100%;background:var(--line)}.line-dot{position:absolute;top:62rpx;width:13rpx;height:13rpx;border-radius:50%}.receive-dot{background:var(--primary)}.give-dot{background:var(--accent)}.record-copy{padding-left:18rpx}.event{font-size:31rpx;font-weight:680;margin-bottom:7rpx}.record-copy .muted{font-size:22rpx}.source{display:inline-flex;color:var(--primary);background:var(--soft);font-size:19rpx;padding:5rpx 10rpx;border-radius:999rpx;margin-top:7rpx}.record-item .amount{font-size:31rpx}.add-record-bar{position:fixed;left:0;right:0;bottom:0;padding:20rpx 34rpx calc(env(safe-area-inset-bottom) + 22rpx);background:var(--bg)}.add-record{height:98rpx;background:var(--primary)!important;color:#fff!important;border-radius:24rpx;font-weight:700}.add-record::after{border:0}
