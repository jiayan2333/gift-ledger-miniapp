<view class="page theme-{{theme}} records-page"><view class="records-head"><view class="eyebrow">HISTORY</view><view class="title">{{contact.name}}的往来</view><view class="muted">共 {{records.length}} 笔，按日期倒序排列</view></view><view wx:if="{{!records.length}}" class="empty">还没有往来记录</view><view wx:else class="records-list"><view wx:for="{{records}}" wx:key="_id" class="record-item" data-id="{{item._id}}" bindtap="editRecord"><view class="record-date"><view class="year">{{item.year}}</view><view>{{item.monthDay}}</view></view><view class="record-line"><view class="line-dot {{item.direction==='RECEIVE'?'receive-dot':'give-dot'}}"></view></view><view class="record-copy"><view class="event">{{item.eventName}}</view><view class="muted">{{item.direction==='RECEIVE'?'对方给我':'我给对方'}}</view><view wx:if="{{item.ledgerId}}" class="source">来自高级账本</view></view><view class="amount {{item.direction==='RECEIVE'?'receive':'give'}}">{{item.amountText}}</view></view></view><view class="add-record-bar"><button class="add-record" bindtap="addRecord">再记一笔</button></view></view>
