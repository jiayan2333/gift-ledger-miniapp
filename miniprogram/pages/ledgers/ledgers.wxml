<view class="page theme-{{theme}} shelf-page"><view class="shelf-head"><view><view class="eyebrow">MY LEDGERS</view><view class="title">我的账本</view><view class="muted shelf-subtitle">每一本，都装着一段重要的人情往来。</view></view><view class="quota-badge">剩余 {{quota}}</view></view><scroll-view scroll-x class="category-scroll"><view class="categories"><view wx:for="{{categories}}" wx:key="id" class="category {{activeCategory===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></view></scroll-view><view wx:if="{{!filtered.length}}" class="shelf-empty">这个分类还没有账本</view><view class="bookshelf"><view wx:for="{{filtered}}" wx:key="_id" class="book" data-id="{{item._id}}" bindtap="openLedger"><view class="book-cover cover-{{index%4}}"><view class="book-event">{{item.eventName}}</view><view class="book-title">{{item.name}}</view><view class="book-date">{{item.eventDate}}</view></view><view class="book-meta">{{item.recordCount||0}} 笔记录</view></view><view class="book add-book" bindtap="createLedger"><view class="book-cover add-cover"><view class="plus">＋</view><view>新建账本</view></view><view class="book-meta">免费试用 / 会员开通</view></view></view><view class="shelf-line"></view></view>
