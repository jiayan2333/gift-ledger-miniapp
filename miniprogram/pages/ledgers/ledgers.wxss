.shelf-page{padding-top:50rpx}.shelf-head{display:flex;align-items:flex-start;justify-content:space-between}.shelf-subtitle{font-size:24rpx;margin-top:14rpx;max-width:480rpx}.quota-badge{background:var(--soft);color:var(--primary);padding:12rpx 18rpx;border-radius:999rpx;font-size:23rpx}.category-scroll{margin:38rpx -36rpx 30rpx;width:auto;white-space:nowrap}.categories{display:flex;padding:0 36rpx;gap:16rpx}.category{display:inline-flex;padding:14rpx 24rpx;background:var(--surface);color:var(--muted);border-radius:999rpx;font-size:25rpx}.category.active{background:var(--primary);color:#fff}.bookshelf{display:grid;grid-template-columns:repeat(3,1fr);gap:28rpx 22rpx}.book-cover{height:244rpx;border-radius:12rpx 22rpx 22rpx 12rpx;padding:20rpx 16rpx;box-sizing:border-box;color:#fff;display:flex;flex-direction:column;box-shadow:inset 8rpx 0 rgba(0,0,0,.08),0 12rpx 22rpx rgba(32,30,28,.1)}.cover-0{background:#55766F}.cover-1{background:#88654E}.cover-2{background:#8A747C}.cover-3{background:#A7463F}.book-event{font-size:19rpx;opacity:.75}.book-title{font-family:"STSong","Songti SC",serif;font-size:30rpx;font-weight:700;line-height:1.35;margin:auto 0}.book-date{font-size:19rpx;opacity:.8}.book-meta{text-align:center;color:var(--muted);font-size:21rpx;margin-top:10rpx}.add-cover{background:#373A39;align-items:center;justify-content:center;color:#D8DDD9}.plus{font-size:62rpx;font-weight:200;margin-bottom:8rpx}.shelf-line{height:18rpx;background:var(--line);border-radius:8rpx;margin-top:18rpx;box-shadow:0 8rpx 16rpx rgba(32,30,28,.08)}.shelf-empty{text-align:center;color:var(--muted);font-size:24rpx;margin:60rpx 0 22rpx}
